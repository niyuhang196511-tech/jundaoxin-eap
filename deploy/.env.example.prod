# EAP 生产环境模板（M47-C）：复制为 .env.prod 并逐项填写
# 带 [*] 的项为必改——EAP_STRICT_CONFIG=1 会在启动时校验其中密钥项，缺失/默认值直接拒绝启动
# 校验逻辑见 eap/src/eap/__main__.py::insecure_config_problems

# ---- 镜像版本 [*] ----
# ghcr 镜像 tag（release.yml 打 v* tag 自动发布）；控制台镜像同理（console-image job）
EAP_VERSION=latest
EAP_IMAGE=ghcr.io/example/eap
EAP_CONSOLE_IMAGE=ghcr.io/example/eap-console

# ---- 数据库 [*] ----
POSTGRES_USER=eap
POSTGRES_PASSWORD=            # [*] 强口令（openssl rand -base64 24）
POSTGRES_DB=eap
# 后端连接串由 compose 组装；如需外置 PG，改写各服务的 EAP_DB_URL
# RLS 角色收敛（M51-C）：置 eap_app 启用——JWT 租户通道事务内 SET LOCAL ROLE 到非 owner
# 应用角色，11 张表的 RLS 行级隔离策略真实生效；留空 = 关闭（owner 豁免，与历史行为一致）。
# 前提：先跑迁移（compose 的 eap-migrate 服务自动 alembic upgrade head）建角色并授权。
# 启用步骤 / 验证 SQL / 回滚 / 托管 RDS 注意事项见 docs/11-production-runbook.md §2。
EAP_DB_APP_ROLE=

# ---- 安全密钥 [*]（EAP_STRICT_CONFIG=1 校验项）----
EAP_DEV_API_KEY=              # [*] 控制台/API 访问密钥（openssl rand -hex 24）；生产建议改走 OIDC/SSO（EAP_OIDC_*）
EAP_SESSION_SECRET=           # [*] 嵌入会话签名密钥（openssl rand -hex 32）
EAP_SECRET_KEY=               # [*] 静态秘密加密（Fernet，python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"）
EAP_SKILL_SIGNING_KEY=        # [*] 技能包 Ed25519 签名私钥（32 字节 hex）；对应公钥经 /api/v1/skills/public-key 分发

# ---- 边缘 ----
EDGE_HTTP_PORT=80             # nginx 对外端口；TLS 建议在上层 LB 或补 443 挂证书
NEXT_PUBLIC_API_BASE_URL=https://api.example.com   # [*] 控制台构建期注入的 API 地址（改镜像后需重新 build）

# ---- 运行时 ----
EAP_WORKER_COUNT=2
EAP_CORS_ORIGINS=https://console.example.com   # [*] 控制台实际来源（逗号分隔；'*' 在 strict 模式禁止）
# EAP_MEDIA_DIR 由 compose 固定为 /data/media（媒体卷）

# ---- 模型供应商（不配则仅内置 mock，平台可离线运行）----
# EAP_OPENAI_BASE_URL=
# EAP_OPENAI_API_KEY=
# EAP_OPENAI_MODEL=

# ---- OIDC/SSO（生产推荐，替代 dev api key 通道）----
# EAP_OIDC_ISSUER=
# EAP_OIDC_CLIENT_ID=
# EAP_OIDC_CLIENT_SECRET=

# ---- 审计保留（M47-B：0=永久）----
EAP_AUDIT_RETENTION_DAYS=365

# ---- 可选：Milvus 向量栈（COMPOSE_PROFILES=milvus 启用）----
# COMPOSE_PROFILES=milvus
# MINIO_ACCESS_KEY=           # [*] 启用 milvus profile 时必填
# MINIO_SECRET_KEY=           # [*]
# EAP_MILVUS_URI=http://milvus:19530
