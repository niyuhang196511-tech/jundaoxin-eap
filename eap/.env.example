# EAP 平台配置清单（全部 EAP_ 前缀环境变量；复制为 .env 或注入容器）
# 对应 src/eap/config.py Settings；带 * 的项生产环境必须修改
# 完整运维说明见 docs/11-production-runbook.md

# ---- 服务 ----
# * 默认绑定回环（安全默认）；容器部署用 0.0.0.0，多网卡显式指定
EAP_HOST=127.0.0.1
EAP_PORT=8300
# * 开发默认 SQLite；生产 PostgreSQL（compose 内为 postgres+psycopg）：
#   EAP_DB_URL=postgresql+psycopg://eap:eap@postgres:5432/eap
EAP_DB_URL=sqlite:///./eap.db

# * CORS 白名单（逗号分隔 origin）：默认空 = 仅同源（不挂 CORS 中间件）；
#   控制台独立部署（跨源）时填其来源；"*" 全放行仅限本地开发
# EAP_CORS_ORIGINS=https://console.corp.cn
EAP_CORS_ORIGINS=

# ---- 开发租户与密钥 ----
# * 生产必须更换（生产鉴权走 OIDC/SSO 或外部 JWT，docs/06 §1）；启动日志会警告默认值
EAP_DEV_API_KEY=dev-key-1
EAP_DEV_TENANT=dev

# * 静态秘密加密密钥（M8）：模型/连接器的 api_key 入库加密（Fernet）
#   生成：openssl rand -hex 32 —— 生成后不可更换（否则库内密文无法解密）
#   未配置 = 明文存储（仅开发，启动有警告）
# EAP_SECRET_KEY=

# ---- 模型中心：外部 OpenAI 兼容供应商（不配置则仅用内置 mock，完全离线可运行）----
# 示例（DeepSeek）：EAP_OPENAI_BASE_URL=https://api.deepseek.com/v1
EAP_OPENAI_BASE_URL=
EAP_OPENAI_API_KEY=
EAP_OPENAI_MODEL=deepseek-chat
# 自定义模型/专属模型经 /api/v1/models 注册（api_key 入库自动加密），此处仅配默认外部供应商

# ---- 文档解析（M14）：默认 local（pypdf/python-docx）；MinerU 支持扫描件/复杂版式 → Markdown ----
# EAP_DOCS_PARSER=local        # local | mineru_cloud | mineru_selfhosted
# MinerU 云端（mineru.net 开放 API）：在官网申请 API Token
# EAP_MINERU_API_URL=https://mineru.net/api/v4
# EAP_MINERU_TOKEN=
# MinerU 自托管（mineru-api 部署）：填 http://host:port，EAP_MINERU_TOKEN 可为部署的鉴权值
# EAP_MINERU_API_URL=http://mineru.local:8000

# ---- 知识中心 ----
# hash = 离线确定性嵌入（开发）；生产切 openai 或自建嵌入服务
EAP_EMBEDDING_PROVIDER=hash
EAP_EMBED_DIM=256

# ---- Runtime ----
EAP_MAX_CONTEXT_CHARS=6000
EAP_AGENT_MAX_STEPS=4

# ---- 注册钩子：额外扫描的智能体模块（逗号分隔或 JSON 列表）----
# EAP_AGENT_MODULES='["my_pkg.agents"]'

# ---- 扩展开发体系：插件目录（手写工具/RAG 组件/Agent）----
# 每个子目录一个插件包，manifest.py 暴露 EAP_PLUGIN；模板：python -m eap.scaffold
EAP_PLUGINS_DIR=./plugins

# ---- 嵌入外链 ----
# * 生产必须更换为强随机密钥（会话令牌 HMAC 签名）
EAP_SESSION_SECRET=dev-session-secret-change-me
EAP_EMBED_SESSION_TTL=7200
EAP_EMBED_RATE_LIMIT=60

# ---- 多副本任务队列（docs/03 §5）：配置后任务经 Redis Streams 跨实例分发 ----
# * 多副本部署必须配置；单机不配置则用进程内 asyncio 队列（PENDING 恢复兜底）
# compose 已内置 redis 服务
EAP_REDIS_URL=redis://redis:6379/0

# ---- 向量路生产形态（docs/04 §1）：配置后向量检索走 Milvus（不可达自动回退本地余弦）----
# compose 已内置 milvus standalone（etcd+minio）；需 uv sync --extra milvus
EAP_MILVUS_URI=http://milvus:19530

# ---- 图谱实体抽取（docs/04 §1）：llm=模型结构化抽取（失败自动回退词元共现）----
EAP_GRAPH_EXTRACTION=lexical

# ---- MCP 端点鉴权（docs/04 §5）：默认开启（校验平台 API Key）----
# 内网可信环境可关闭：EAP_MCP_AUTH=0
EAP_MCP_AUTH=1

# ---- OIDC/SSO（docs/06 §1）：配置 issuer+client_id 即启用 ----
# 示例（Keycloak/企业微信扫码/钉钉 等 标准 OIDC IdP）：
#   EAP_OIDC_ISSUER=https://sso.corp.cn/realms/eap
#   EAP_OIDC_CLIENT_ID=eap-console
#   EAP_OIDC_CLIENT_SECRET=xxx
EAP_OIDC_ISSUER=
EAP_OIDC_CLIENT_ID=
EAP_OIDC_CLIENT_SECRET=
EAP_OIDC_REDIRECT_URI=http://localhost:8300/api/v1/auth/oidc/callback

# ---- 资源服务器模式（M6）：外部租户系统签发的 JWT access token 接入 ----
# claims 映射：tenant_id/tid → 租户，sub → 用户，roles → 角色；
# * 生产建议显式约束 aud（IdP 为本平台签发的 audience 值）
# EAP_JWT_AUDIENCE=eap-api

# ---- 技能包签名（Ed25519 seed，32 字节 hex；技能市场分发链信任根）----
# * 生产必须更换（公钥经 /api/v1/skills/public-key 分发）
# EAP_SKILL_SIGNING_KEY=
