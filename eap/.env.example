# EAP 平台配置清单（全部 EAP_ 前缀环境变量；复制为 .env 或注入容器）
# 对应 src/eap/config.py Settings；带 * 的项生产环境必须修改

# ---- 服务 ----
EAP_HOST=0.0.0.0
EAP_PORT=8300
# * 开发默认 SQLite；生产 PostgreSQL（compose 内为 postgres+psycopg）：
#   EAP_DB_URL=postgresql+psycopg://eap:eap@postgres:5432/eap
EAP_DB_URL=sqlite:///./eap.db

# ---- 开发租户与密钥 ----
# * 生产必须更换（生产鉴权走 OIDC/SSO，docs/06 §1）
EAP_DEV_API_KEY=dev-key-1
EAP_DEV_TENANT=dev

# ---- 模型中心：外部 OpenAI 兼容供应商（不配置则仅用内置 mock，完全离线可运行）----
# 示例（DeepSeek）：EAP_OPENAI_BASE_URL=https://api.deepseek.com/v1
EAP_OPENAI_BASE_URL=
EAP_OPENAI_API_KEY=
EAP_OPENAI_MODEL=deepseek-chat
# 自定义模型/专属模型经 /api/v1/models 注册（docs/02 ①），此处仅配默认外部供应商

# ---- 知识中心 ----
# hash = 离线确定性嵌入（开发）；生产切 openai 或自建嵌入服务
EAP_EMBEDDING_PROVIDER=hash
EAP_EMBED_DIM=256

# ---- Runtime ----
EAP_MAX_CONTEXT_CHARS=6000
EAP_AGENT_MAX_STEPS=4

# ---- 注册钩子：额外扫描的智能体模块（逗号分隔或 JSON 列表）----
# EAP_AGENT_MODULES='["my_pkg.agents"]'

# ---- 嵌入外链 ----
# * 生产必须更换为强随机密钥（会话令牌 HMAC 签名）
EAP_SESSION_SECRET=dev-session-secret-change-me
EAP_EMBED_SESSION_TTL=7200
EAP_EMBED_RATE_LIMIT=60

# ---- 多副本任务队列（docs/03 §5）：配置后任务经 Redis Streams 跨实例分发 ----
# 单机不配置则用进程内 asyncio 队列；compose 已内置 redis 服务
EAP_REDIS_URL=redis://redis:6379/0

# ---- MCP 端点鉴权（docs/04 §5）：默认开启（校验平台 API Key）----
# 内网可信环境可关闭：EAP_MCP_AUTH=0
EAP_MCP_AUTH=1

# ---- OIDC/SSO（docs/06 §1）：配置 issuer+client_id 即启用 ----
# 示例（Keycloak/企业微信扫码/钉钉 等 标准 OIDC IdP）：
#   EAP_OIDC_ISSUER=https://sso.corp.cn/realms/eap
#   EAP_OIDC_CLIENT_ID=eap-console
#   EAP_OIDC_CLIENT_SECRET=xxx
EAP_OIDC_ISSUER=
EAP_OIDC_CLIENT_ID=
EAP_OIDC_CLIENT_SECRET=
EAP_OIDC_REDIRECT_URI=http://localhost:8300/api/v1/auth/oidc/callback

# ---- 技能包签名（Ed25519 seed，32 字节 hex；技能市场分发链信任根）----
# * 生产必须更换（公钥经 /api/v1/skills/public-key 分发）
# EAP_SKILL_SIGNING_KEY=
