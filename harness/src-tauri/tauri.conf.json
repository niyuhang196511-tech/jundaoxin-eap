{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EAP Harness",
  "version": "1.0.0",
  "identifier": "com.eap.harness",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5177",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EAP Harness",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png"]
  }
}
