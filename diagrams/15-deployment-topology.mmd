            RT0["Agent Runtime Pod ×n"] ; WRK["Worker 池（Agent/RAG/Tool）"] ; VLLM["vLLM GPU 池（A100×2 起）"]
        end
        subgraph DATA["存储"]
            PG[("PostgreSQL")] ; RDS[("Redis 集群")] ; MIL[("Milvus")] ; NEO[("Neo4j/TuGraph")] ; MIO[("MinIO")]
        end
        OBS["观测栈：OTel / Langfuse / Prometheus / Grafana"]
    end
